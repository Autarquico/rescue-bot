[Unit]
Description=Hermes Agent gateway (conversación en Slack, solo lectura)
After=network-online.target tailscaled.service rescue-approver.service
Wants=network-online.target

[Service]
User=agent
Group=agent
SupplementaryGroups=rescue-ipc
Environment=HOME=/var/lib/rescue-agent
Environment=HERMES_HOME=/var/lib/rescue-agent/.hermes
Environment=RESCUE_CONFIG=/etc/rescue-bot/config
Environment=RESCUE_SOCKET=/run/rescue/approver.sock
Environment=RESCUE_KEY_RO=/etc/rescue-bot/agent/key_ro
EnvironmentFile=/etc/rescue-bot/agent/hermes.env
WorkingDirectory=/var/lib/rescue-agent/.hermes/workspace
ExecStart=/usr/local/bin/hermes gateway
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
# Solo los subdirectorios de estado (propiedad de agent, creados por provision.sh); el resto es de root.
ReadWritePaths=/var/lib/rescue-agent/.hermes/sessions /var/lib/rescue-agent/.hermes/logs /var/lib/rescue-agent/.hermes/memories /var/lib/rescue-agent/.hermes/cache /var/lib/rescue-agent/.hermes/workspace
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
